<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.memory-watcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__INSTALL_DIR__/scripts/memory_watcher.sh</string>
    </array>

    <!-- Every 1 hour (3600 seconds) -->
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/logs/memory_watcher_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/logs/memory_watcher_stderr.log</string>
</dict>
</plist>
